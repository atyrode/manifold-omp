{
  "id": "atyrode.omp.accounts",
  "version": "0.1.0",
  "title": "omp accounts",
  "description": "Independent OMP accounts over governed native Manifold resources.",
  "capabilities": [
    "containers:read",
    "containers:write",
    "terminals:spawn",
    "machines:run",
    "jobs:read",
    "jobs:input",
    "jobs:cancel",
    "services:read",
    "services:configure",
    "network:host",
    "locations:read",
    "locations:write",
    "services:invoke"
  ],
  "contributes": {
    "panels": [],
    "sections": [],
    "elements": [],
    "tools": [],
    "events": []
  },
  "dependencies": {
    "atyrode.omp": {
      "type": "required",
      "reason": "Required independent OMP family authority boundary."
    }
  },
  "machine": {
    "artifacts": {},
    "tools": {},
    "requiresResourceBindings": true,
    "operations": {
      "atyrode.omp.accounts.broker": {
        "argv": [
          {
            "literal": "/job/artifact"
          }
        ],
        "input": {
          "clientAccess": {
            "type": "string",
            "required": true,
            "maxLength": 1024
          }
        },
        "runtimeTools": [
          "bun",
          "pi-natives",
          "ca-certificates",
          "system"
        ],
        "executable": {
          "runtimeTool": "bun"
        },
        "environment": {
          "SSL_CERT_FILE": "/runtime/bin/ca-certificates",
          "PI_CONFIG_DIR": "omp",
          "PI_CODING_AGENT_DIR": "/home/job/omp/agent"
        },
        "inputFiles": {
          "clientAccess": {
            "input": "clientAccess"
          },
          "serviceBearer": {
            "generated": "service-bearer"
          }
        },
        "providesService": true,
        "services": [],
        "locations": [
          {
            "locationId": "atyrode.omp.accounts.omp-auth",
            "access": "write"
          }
        ],
        "outputs": [],
        "network": "host",
        "limits": {
          "timeoutMs": 600000,
          "memoryBytes": 1073741824,
          "processes": 128,
          "outputBytes": 262144
        },
        "stdin": false
      },
      "atyrode.omp.accounts.sign-in": {
        "argv": [
          {
            "literal": "--allow-home"
          },
          {
            "literal": "--no-session"
          },
          {
            "literal": "--config"
          },
          {
            "literal": "/home/job/.omp/agent/config.yml"
          }
        ],
        "input": {
          "config": {
            "type": "string",
            "required": true,
            "maxLength": 128
          }
        },
        "runtimeTools": [
          "omp",
          "ca-certificates",
          "system"
        ],
        "executable": {
          "runtimeTool": "omp"
        },
        "environment": {
          "SSL_CERT_FILE": "/runtime/bin/ca-certificates",
          "PI_CONFIG_DIR": "omp",
          "PI_CODING_AGENT_DIR": "/home/job/omp/agent"
        },
        "inputFiles": {
          "config": {
            "input": "config",
            "homePath": [
              ".omp",
              "agent",
              "config.yml"
            ]
          }
        },
        "services": [],
        "locations": [
          {
            "locationId": "atyrode.omp.accounts.omp-auth",
            "access": "write"
          }
        ],
        "outputs": [],
        "network": "host",
        "limits": {
          "timeoutMs": 1800000,
          "memoryBytes": 2147483648,
          "processes": 128,
          "outputBytes": 8388608
        },
        "stdin": true
      }
    },
    "locations": {
      "atyrode.omp.accounts.omp-auth": {
        "anchor": "state",
        "components": [
          "omp",
          "shared-auth"
        ],
        "revision": "1",
        "kind": "directory",
        "managed": true,
        "guestPath": "/home/job/omp"
      }
    }
  },
  "entry": {
    "server": true
  }
}
