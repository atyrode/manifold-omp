{
  "id": "atyrode.omp",
  "version": "0.1.0",
  "title": "omp",
  "description": "Independent OMP execution over governed native Manifold resources. Restricted automation uses the supported OMP18.2.7 SDK registry with explicit tool names and no delegation. Operator resume preserves persisted exact model/thinking unless explicitly overridden; missing or incompatible state refuses before inference. Placement independently authorizes its container and terminal.",
  "capabilities": [
    "containers:read",
    "containers:write",
    "terminals:spawn",
    "machines:read",
    "machines:run",
    "jobs:read",
    "jobs:input",
    "jobs:cancel",
    "services:read",
    "services:invoke",
    "services:configure",
    "network:host",
    "locations:read",
    "locations:write",
    "locations:create",
    "operations:invoke"
  ],
  "dataVersion": {
    "major": 1,
    "minor": 0
  },
  "purges": [
    "storage"
  ],
  "contributes": {
    "panels": [],
    "sections": [],
    "elements": [],
    "tools": [],
    "events": [],
    "harness": {
      "id": "atyrode.omp",
      "title": "OMP",
      "profileSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "accountPool": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "additionalProperties": {
              "maxItems": 1024,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "credentialId": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "identityKey": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "scope",
                  "credentialId",
                  "identityKey"
                ],
                "additionalProperties": false
              }
            }
          },
          "overlay": {
            "type": "object",
            "properties": {
              "modelRoles": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/[A-Za-z0-9][A-Za-z0-9._/:-]{0,511}$"
                }
              },
              "retry": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "modelFallback": {
                    "type": "boolean"
                  },
                  "fallbackRevertPolicy": {
                    "type": "string",
                    "const": "cooldown-expiry"
                  },
                  "fallbackChains": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "additionalProperties": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/[A-Za-z0-9][A-Za-z0-9._/:-]{0,511}$"
                      }
                    }
                  }
                },
                "required": [
                  "enabled",
                  "modelFallback"
                ],
                "additionalProperties": false
              },
              "task": {
                "type": "object",
                "properties": {
                  "agentModelOverrides": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\/[A-Za-z0-9][A-Za-z0-9._/:-]{0,511}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^@[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        }
                      ]
                    }
                  },
                  "agentAdvisor": {
                    "type": "object",
                    "properties": {
                      "task": {
                        "type": "string",
                        "enum": [
                          "on",
                          "off"
                        ]
                      }
                    },
                    "required": [
                      "task"
                    ],
                    "additionalProperties": false
                  },
                  "prewalk": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "prewalk": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ],
                "additionalProperties": false
              },
              "defaultThinkingLevel": {
                "type": "string",
                "enum": [
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "advisor": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ],
                "additionalProperties": false
              },
              "tier": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            },
            "additionalProperties": false
          },
          "planYolo": {
            "type": "boolean"
          }
        },
        "required": [
          "accountPool",
          "overlay",
          "planYolo"
        ],
        "additionalProperties": false
      },
      "sessionRef": "typed"
    }
  },
